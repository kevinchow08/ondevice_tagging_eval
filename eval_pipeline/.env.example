# 复制这个文件为 .env，填入你自己的真实值。.env 已在 .gitignore 里，不会被提交。

# 被测的端侧模型（本地服务，通常不需要改，除非你换了端口/引擎）
# SMALL_MODEL_BASE_URL=http://localhost:8080
# SMALL_MODEL_API_KEY=sk-no-key-required
# SMALL_MODEL_NAME=qwen3.5-2b

# 裁判/参考模型（云端 API 或本地另起的更大模型）
REFERENCE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
REFERENCE_API_KEY=
REFERENCE_MODEL_NAME=qwen3.8-max
